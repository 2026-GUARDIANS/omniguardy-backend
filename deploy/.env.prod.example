# Copy to deploy/.env.prod on EC2. Blank required values must be filled there.
BACKEND_IMAGE=
SPRING_PROFILES_ACTIVE=prod
SWAGGER_ENABLED=true
MYSQL_DATABASE=omniguardy_db
DB_URL=jdbc:mysql://mysql:3306/omniguardy_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
DB_USERNAME=omniguardy
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_TIME=1800000
JWT_REFRESH_TOKEN_EXPIRE_TIME=1209600000
MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_CLIENT_ID=omniguardy-prod
# Match deploy/mosquitto/acl and the password file.
MQTT_USERNAME=backend
MQTT_PASSWORD=
MQTT_TOPIC_CAMERA=door/camera
AUDIO_DEVICE_API_KEY=
# Required by Compose. Separate from device/JWT credentials; share with Vision securely.
# Vision sends this in X-Vision-Callback-Key. Do not commit the real value.
VISION_CALLBACK_API_KEY=
# Required: Streaming origin reachable from the backend container (no trailing /vision path).
# No vision-streaming service exists in this compose. Do not use container localhost.
# Keep AI_FASTAPI_VISION_BASE_URL below for the separate LEGACY MP4/fallback server.
STREAMING_VISION_BASE_URL=
# Enabled on initial deployment. Existing eligible DB jobs also resume automatically.
STREAMING_VISION_POLLING_ENABLED=true
STREAMING_VISION_POLL_INTERVAL=2s
STREAMING_VISION_MAX_WAIT=5m
STREAMING_VISION_CONNECT_TIMEOUT=2s
STREAMING_VISION_READ_TIMEOUT=5s
STREAMING_VISION_LEASE_DURATION=30s
STREAMING_VISION_BATCH_SIZE=10
STREAMING_VISION_SCHEDULER_DELAY_MS=1000
STREAMING_AGENT_ENABLED=true
STREAMING_AGENT_PREPARATION_LEASE=30s
STREAMING_AGENT_CALLING_LEASE=5m
STREAMING_AGENT_RETRY_DELAY=10s
STREAMING_AGENT_MAX_ATTEMPTS=3
STREAMING_AGENT_BATCH_SIZE=10
STREAMING_AGENT_SCHEDULER_DELAY_MS=1000
STREAMING_VIDEO_UPLOAD_LEASE=5m
VISION_FALLBACK_ENABLED=true
VISION_FALLBACK_RETRY_DELAY=10s
VISION_FALLBACK_VIDEO_WAIT=10m
VISION_FALLBACK_VISION_LEASE=5m
VISION_FALLBACK_AGENT_LEASE=5m
VISION_FALLBACK_MAX_VISION_ATTEMPTS=3
VISION_FALLBACK_MAX_PREPARATION_ATTEMPTS=3
VISION_FALLBACK_BATCH_SIZE=10
VISION_FALLBACK_SCHEDULER_DELAY_MS=1000
OMNIGUARDY_DEMO_USERID=
AI_FASTAPI_AUDIO_BASE_URL=
AI_FASTAPI_AUDIO_ENDPOINT=/predict
AI_FASTAPI_VISION_BASE_URL=
AI_FASTAPI_VISION_ENDPOINT=/analyze/vision
AUDIO_CONNECT_TIMEOUT_SECONDS=10
AUDIO_READ_TIMEOUT_SECONDS=60
VISION_CONNECT_TIMEOUT_SECONDS=10
VISION_READ_TIMEOUT_SECONDS=180
AGENT_AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=60
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=
S3_VIDEO_PREFIX=videos
FIREBASE_CREDENTIALS_HOST_PATH=/opt/omniguardy/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
# Native React Native does not require CORS. Add exact HTTPS web origins only if needed.
CORS_ALLOWED_ORIGINS=
COOKIE_SAME_SITE=Lax
MULTIPART_MAX_FILE_SIZE=100MB
MULTIPART_MAX_REQUEST_SIZE=105MB
