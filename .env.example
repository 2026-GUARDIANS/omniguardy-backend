# Copy this file to .env and replace the placeholder locally.
# Never commit the real .env file or an actual OpenAI API key.
AGENT_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=60
# Dedicated secret shared only with the Vision callback sender. Empty disables callback access.
VISION_CALLBACK_API_KEY=